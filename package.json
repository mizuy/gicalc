{
  "name": "gicalc",
  "main": "expo-router/entry",
  "version": "1.0.8",
  "private": true,
  "homepage": "https://mizuy.github.io/gicalc/",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:export": "expo export -p web",
    "build:web": "expo export -p web && node scripts/prepare-pages.mjs && npx workbox-cli generateSW workbox-config.js",
    "build:pages": "EXPO_PUBLIC_BASE_URL=/gicalc npm run build:web",
    "preview:web": "npx serve dist",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test": "tsx --test scripts/verify-scores.ts",
    "optimize:figures": "python3 scripts/optimize-figures.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "serve": "^14.2.6",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "workbox-cli": "^7.3.0"
  }
}
